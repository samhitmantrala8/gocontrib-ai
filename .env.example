# Copy this file to .env and fill in your keys.
#
# The runtime rotates across every key for every model on every provider
# before giving up, so it is fine (and recommended) to paste several keys
# below. Comma-separate multiple keys for the same provider.

# Gemini (free tier from https://aistudio.google.com/apikey).
# Use the plural form to pass several keys; each will be tried in turn.
GEMINI_API_KEYS=

# OpenRouter (https://openrouter.ai/keys). Used as fallback when the whole
# Gemini pool is exhausted. Multiple keys allowed (comma-separated).
OPENROUTER_API_KEYS=

# GitHub token for issue / PR fetches. Without it the public anonymous
# limit usually still works for a single issue, but the convention learner
# that scrapes recent PRs is much faster with a token.
GITHUB_TOKEN=
